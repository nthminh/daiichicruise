{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "research/**",
      "gd1/**",
      "design_handoff_daiichi_gd1/**",
      "Audit*.html",
      "Handoff*.html",
      "Báo cáo*.html",
      "Go-live*.html",
      "*.md"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "appAssociation": "AUTO",
    "headers": [
      {
        "source": "assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      },
      {
        "source": "**/*.@(css|js|jsx)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=600" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "redirects": [
      { "source": "/home", "destination": "/index.html", "type": 301 },
      { "source": "/booking", "destination": "/customer/Daiichi Travel.html", "type": 301 }
    ]
  }
}
